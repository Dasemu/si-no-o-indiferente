{
  "name": "historias-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API que sirve el mazo diario de historias y genera 5 historias nuevas por dia con Gemini",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "generate": "tsx src/scripts/generateDaily.ts",
    "generate:built": "node dist/scripts/generateDaily.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
