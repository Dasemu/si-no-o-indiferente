# Port the API listens on
PORT=8787

# Allowed CORS origin (the URL the frontend/PWA is served from).
# Use "*" only in development.
CORS_ORIGIN=*

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model used to generate stories
GEMINI_MODEL=gemini-3.5-flash

# How many new stories to generate per day
STORIES_PER_DAY=5

# Folder where generated stories (JSON) are stored, relative to the backend
DATA_DIR=./data

# Secret token to manually trigger generation via POST /api/admin/generate
ADMIN_TOKEN=change-this-token

# Minimum number of player ratings a story needs before the periodic
# reclassification job will adjust its difficulty
MIN_RATINGS_FOR_RECLASSIFICATION=3
