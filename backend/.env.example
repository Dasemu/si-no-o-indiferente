# Puerto donde escucha la API
PORT=8787

# Origen permitido para CORS (la URL desde donde se sirve el frontend/PWA).
# Usa "*" solo en desarrollo.
CORS_ORIGIN=*

# API key de Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de Gemini a usar para generar historias
GEMINI_MODEL=gemini-2.5-flash

# Cuantas historias nuevas generar por dia
STORIES_PER_DAY=5

# Carpeta donde se guardan las historias generadas (JSON), relativa al backend
DATA_DIR=./data

# Token secreto para poder disparar la generacion manualmente via POST /api/admin/generate
ADMIN_TOKEN=cambia-este-token
